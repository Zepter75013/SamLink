# Copier ce fichier en "backend/.env" (développement local) ou ".env" à la racine (Docker sur le NAS), non versionnés,
# et remplir les valeurs réelles.

# Base du club (adhérents : table profil, adhésions : table adhesion). Sam Link y ajoute ses propres tables.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=SamProd26db
DB_USER=
DB_PASSWORD=

# Port de l'API et URL publique du frontend (utilisée pour l'en-tête CORS et les liens des e-mails)
# Sur le NAS : FRONTEND_URL=https://samlink.juliotte-app.fr (DB_HOST est imposé à bdd-mysql par docker-compose.yml)
APP_PORT=8080
FRONTEND_URL=http://localhost:5173

# Secret de signature des jetons de session (chaîne aléatoire longue)
JWT_SECRET=

# Adhérents actifs : adhésion validée pour la saison en cours. La saison change le 1er du mois SAISON_MOIS_DEBUT
# (2027 = 2026-2027). SAISON fixe la saison à la main (laisser vide pour le calcul automatique).
SAISON=
SAISON_MOIS_DEBUT=9

# Valeurs de profil.idRole qui forment le salon « Bureau » (séparées par des virgules). 9 = Gentil Organisateur.
BUREAU_ROLES=9

# Adresse du site qui sert les photos des adhérents (profil.photo = ../Contenus/uploads/profils/…).
# Vide : pas de photo, les initiales sont affichées.
PHOTOS_BASE_URL=

# Notifications push : clés VAPID à générer UNE SEULE FOIS avec  cd backend && go run ./cmd/vapid
# (changer de clés désabonne tous les appareils). Sans clés, le push est désactivé ; les e-mails fonctionnent quand même.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=contact@samparis12.org

# Minutes d'attente avant l'e-mail d'un message non lu (0 : immédiat)
NOTIF_DELAI_EMAIL_MIN=60

# SMTP pour les e-mails de notification
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
